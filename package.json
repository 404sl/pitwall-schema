{
  "name": "@404sl/pitwall-schema",
  "version": "0.3.0",
  "description": "Pitwall snapshot contract - versioned types for project, lane and issue state",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pitwall-snapshot.schema.json": "./dist/pitwall-snapshot.schema.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/404sl/pitwall-schema.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsx scripts/emit-json-schema.ts",
    "prepare": "npm run build",
    "test": "tsx --test test/*.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.10.0"
  }
}
